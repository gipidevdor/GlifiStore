# Generated by scripts/build_docs.py; edit this template instead.
PROJECT_NAME           = GlifiStore
PROJECT_NUMBER         = @VERSION@
PROJECT_BRIEF          = "C++23 key-value engine · Architectural prototype"
PROJECT_LOGO           = "@ROOT@/artwork/apple/raster/glifistore-app-icon-128.png"
OUTPUT_DIRECTORY       = "@OUTPUT@"
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@ROOT@/" "@INPUT@/"
STRIP_FROM_INC_PATH    = "@ROOT@/include/"

INPUT                  = "@ROOT@/include/glifistore" "@INPUT@"
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE  = "@INPUT@/glifistore.md"
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 3
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
SORT_MEMBER_DOCS       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
INLINE_SOURCES         = NO
SOURCE_BROWSER         = YES
VERBATIM_HEADERS       = YES
REFERENCES_LINK_SOURCE = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = "__cplusplus=202302L"

QUIET                  = YES
TIMESTAMP              = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = "@OUTPUT@/warnings.log"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_HEADER            = "@OUTPUT@/header.html"
HTML_EXTRA_STYLESHEET  = "@THEME@/doxygen-awesome.css" \
                         "@THEME@/doxygen-awesome-sidebar-only.css" \
                         "@THEME@/doxygen-awesome-sidebar-only-darkmode-toggle.css" \
                         "@ROOT@/docs/doxygen/custom.css"
HTML_EXTRA_FILES       = "@THEME@/doxygen-awesome-darkmode-toggle.js" \
                         "@THEME@/doxygen-awesome-fragment-copy-button.js"
HTML_COLORSTYLE        = LIGHT
HTML_COPY_CLIPBOARD    = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
IMAGE_PATH             = "@ROOT@/docs/assets" "@ROOT@/artwork/apple/raster"
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
