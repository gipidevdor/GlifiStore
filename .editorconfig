root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl}]
max_line_length = 110

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
