+    success(store->close());
+    store.reset();
+    GLIFI_REQUIRE(std::filesystem::remove(temp.path / "blobs"));
+    GLIFI_REQUIRE(!verify_durable_store_path(temp.path));
+    GLIFI_REQUIRE(!std::filesystem::exists(temp.path / "blobs"));
